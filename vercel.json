{
  "version": 2,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.(html|htm)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(admin|login)?",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|svg|ico|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/api/snapshot",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=3, stale-while-revalidate=10" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/uploads/(.*)", "destination": "/api/index.js?__api_path=uploads/$1" },
    { "source": "/api", "destination": "/api/index.js?__api_path=health" },
    { "source": "/health", "destination": "/api/index.js?__api_path=health" },
    { "source": "/api/(.*)", "destination": "/api/index.js?__api_path=$1" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/login/", "destination": "/login.html" }
  ]
}
